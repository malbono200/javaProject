<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.spring_boot_mini_project.dao.IProductDAO">

	<!-- 카테고리별 상품 조회 -->
	<select id="listCtgProduct" parameterType="string" resultType="com.spring_boot_mini_project.dto.ProductDTO">
		SELECT * FROM product WHERE ctgId=#{ctgId} ORDER BY prdNo
	</select>

	<!-- 상품 상세 조회 -->
	<select id="detailViewProduct" parameterType="string" resultType="com.spring_boot_mini_project.dto.ProductDTO">
		SELECT * FROM product WHERE prdNo=#{prdNo}
	</select>

</mapper>